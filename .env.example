# Smart University — переменные окружения. Скопируйте в .env:  cp .env.example .env
# Файл .env в .gitignore и НЕ попадает в Docker-образ (ключ не утекает).
#
# Для `docker compose up` ОБЯЗАТЕЛЬНЫХ переменных нет: навигатор грантов, FAQ, карточки вузов
# и сравнение работают без ключа. Ключ нужен только чтобы AI-советник (движок A) отвечал.

# Ключ OpenAI — эмбеддинг вопроса + генерация gpt-4o-mini для AI-советника.
# Пусто → ассистент честно скажет «недоступен», всё остальное работает.
OPENAI_API_KEY=

# (опц.) закрыть админ-панель токеном → доступ по /admin?key=ВАШ_ТОКЕН
ADMIN_TOKEN=

# --- Запуск НА ХОСТЕ, вне Docker (для docker compose НЕ нужно — там ставится автоматически) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:55432/smartuni
# EMBED_PROFILE=openai

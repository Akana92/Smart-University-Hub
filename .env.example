# Smart University — переменные окружения (скопируйте в .env; .env в .gitignore).
# Для локального демо (MiniLM + SQLite) НИ ОДНА не обязательна.

# --- Прод-профиль эмбеддингов / генерация (этап 3) ---
# OPENAI_API_KEY=sk-...

# --- Профиль эмбеддингов: local (MiniLM, без ключа) | openai (text-embedding-3-large) ---
# EMBED_PROFILE=local

# --- Postgres (pgvector движка A / реляционный стор движка B) ---
# Поднять: docker compose -f poc/grant-recommender/api/docker-compose.yml up -d
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartuni
